{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Central": {
    "BaseUrl": "https://api.plancope.sistemas.mec.gob.ar"
  },
  "SessionHeartbeat": {
    "Enabled": true,
    "IntervalSeconds": 180,
    "HealthTimeoutSeconds": 2,
    "RequestTimeoutSeconds": 5,
    "StaleSessionHours": 2
  },
  "Local": {
    "SeedDemoExam": false
  }
}
